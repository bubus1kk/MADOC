{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MADOC Concept",
  "version": "0.1.0",
  "identifier": "ru.madoc.desktop.concept",
  "build": {
    "beforeDevCommand": "dotnet build ../MADOC.DesktopBridge/MADOC.DesktopBridge.csproj",
    "beforeBuildCommand": "dotnet publish ../MADOC.DesktopBridge/MADOC.DesktopBridge.csproj -c Release -r win-x64 --self-contained true -o bridge-publish",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MADOC Concept — Документы",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#BFC1C2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../bridge-publish/": "bridge/"
    }
  }
}
